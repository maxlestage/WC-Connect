{
  "name": "WC Connect — site",
  "description": "Site de présentation de WC Connect : React + TypeScript construits par Vite, servis par Express. Déployable en un geste, sans ordinateur.",
  "repository": "https://github.com/maxlestage/WC-Connect",
  "logo": "https://raw.githubusercontent.com/maxlestage/WC-Connect/master/website/public/logo.svg",
  "keywords": ["react", "typescript", "vite", "express", "node", "ios", "site"],
  "website": "https://github.com/maxlestage/WC-Connect",
  "stack": "heroku-24",
  "buildpacks": [
    {
      "url": "heroku/nodejs"
    }
  ],
  "formation": {
    "web": {
      "quantity": 1
    }
  },
  "env": {
    "NPM_CONFIG_PRODUCTION": {
      "description": "Laisser à false : Vite et TypeScript sont nécessaires à la construction du site.",
      "value": "false",
      "required": false
    },
    "NODE_ENV": {
      "description": "Environnement Node utilisé par Express.",
      "value": "production",
      "required": false
    }
  },
  "success_url": "/"
}
